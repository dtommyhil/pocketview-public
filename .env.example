# Run python scripts/init_env.py to create .env with fresh local secrets.
APP_MODE=local
# Optional exact public hostname, used only by the read-only demo mode.
PUBLIC_HOSTNAME=
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://pocketview:${POSTGRES_PASSWORD}@127.0.0.1:55439/pocketview
FLASK_SECRET_KEY=replace-with-random-session-key
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
# A stable opaque ID, not an email address. This is not application authentication.
DEMO_OWNER_ID=pocketview-local-demo
PLAID_ENV=sandbox
# Set these two values ONLY in your local .env using Dashboard > Developers > Keys.
PLAID_CLIENT_ID=
PLAID_SECRET=
